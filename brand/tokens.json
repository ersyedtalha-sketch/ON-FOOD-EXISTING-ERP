{
  "$comment": "ON FOOD design tokens. Source: brand/logo/README.txt. See brand/tokens.css for the CSS custom-property version and usage notes.",
  "brand": {
    "forestGreen": "#1B4D2E",
    "leafGreen": "#7CB342",
    "offWhite": "#FAF9F5",
    "warmBrown": "#5D3A1A"
  },
  "scale": {
    "forest": {
      "900": "#0E2A18",
      "800": "#143B23",
      "700": "#1B4D2E",
      "600": "#26663D",
      "500": "#33804E",
      "300": "#7FAE92",
      "100": "#D6E4DC"
    },
    "leaf": {
      "700": "#4F7A24",
      "600": "#669634",
      "500": "#7CB342",
      "300": "#A8CE81",
      "100": "#E4F0D5"
    },
    "neutral": {
      "0": "#FFFFFF",
      "50": "#FAF9F5",
      "100": "#F1EFE8",
      "200": "#E3E0D6",
      "300": "#C9C5B8",
      "500": "#8A8578",
      "700": "#4D4A42",
      "900": "#21201C"
    }
  },
  "semantic": {
    "$comment": "Warning and danger deliberately sit outside the brand palette so an operator can distinguish a branded panel from a status at a glance.",
    "success": "#7CB342",
    "warning": "#C8811B",
    "danger": "#B3261E",
    "info": "#2A6F97"
  },
  "domain": {
    "$comment": "Expiry state is a first-class concept in a food ERP.",
    "fresh": "#7CB342",
    "nearExpiry": "#C8811B",
    "expired": "#B3261E"
  },
  "typography": {
    "display": {
      "family": "EB Garamond",
      "weight": 700,
      "license": "SIL OFL 1.1",
      "usage": "Wordmark and marketing surfaces only. Never for operational data."
    },
    "ui": {
      "family": "Lato",
      "weights": [400, 700],
      "license": "SIL OFL 1.1",
      "usage": "All interface and table text. Use tabular lining figures for numeric columns."
    }
  },
  "logo": {
    "navbar": "brand/logo/onfood-logo-horizontal.svg",
    "darkSurface": "brand/logo/onfood-logo-horizontal-reversed.svg",
    "stacked": "brand/logo/onfood-logo-primary.svg",
    "favicon": "brand/logo/onfood-icon-square.png",
    "markOnly": "brand/logo/onfood-leaf-mark.svg",
    "minWidthPx": { "horizontal": 150, "stacked": 130 },
    "clearSpace": "Equal to the height of the leaf on all sides."
  }
}
